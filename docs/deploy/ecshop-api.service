[Unit]
Description=cpp_ecshop API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ecshop
Group=ecshop
WorkingDirectory=/opt/cpp-ecshop
EnvironmentFile=/etc/ecshop/ecshop.env
ExecStart=/opt/cpp-ecshop/bin/ecshop_api --bind=127.0.0.1 --port=8080
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ecshop /var/log/ecshop

[Install]
WantedBy=multi-user.target
